# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Configuration
# For Supabase, use the Transaction Pooling connection string
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Node Environment (automatically set by Vercel)
# NODE_ENV=development  # Local development
# NODE_ENV=production   # Vercel deployments

# Security Notes:
# - The dev-mode authentication bypass ONLY works when NODE_ENV=development
# - Vercel automatically sets NODE_ENV=production for all deployments
# - Never commit .env.local or .env files to git
# - Keep SUPABASE_SERVICE_ROLE_KEY secret - it has admin privileges
