{
  "name": "flight-club",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:start": "node scripts/dev-server.js start",
    "dev:stop": "node scripts/dev-server.js stop",
    "dev:restart": "node scripts/dev-server.js restart",
    "dev:status": "node scripts/dev-server.js status",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest --run",
    "test:contract": "vitest --run src/tests/contract",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:only": "vitest --run e2e",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/jwt": "8.0.1",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "2.45.4",
    "dotenv": "16.6.1",
    "fastify": "4.29.1",
    "jose": "5.10.0",
    "next": "14.2.5",
    "p-retry": "7.1.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "resend": "3.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.14.10",
    "@types/react": "18.2.74",
    "@types/react-dom": "18.2.24",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "1.6.1",
    "@vitest/ui": "1.6.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "jsdom": "24.1.3",
    "postcss": "8.4.41",
    "prettier": "3.3.3",
    "prisma": "5.22.0",
    "supertest": "7.2.2",
    "tailwindcss": "3.4.10",
    "tsx": "4.21.0",
    "typescript": "5.5.4",
    "vitest": "1.6.1"
  },
  "overrides": {
    "glob": "13.0.6",
    "rimraf": "6.0.0",
    "inflight": "npm:@blakeembrey/inflight@1.0.6",
    "superagent": "10.2.2",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@0.19.1",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@2.1.4"
  }
}
