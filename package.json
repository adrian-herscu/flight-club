    "@types/node": "20.14.10",
    "@types/react": "18.2.74",
    "@types/react-dom": "18.2.24",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.2.2",
    "@vitest/ui": "^1.2.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "jsdom": "^24.1.0",
    "postcss": "8.4.41",
    "prettier": "3.3.3",
    "prisma": "^5.9.1",
    "supertest": "^6.3.4",
    "tailwindcss": "3.4.10",
    "tsx": "^4.7.0",
    "typescript": "5.5.4",
