# Local development configuration
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Local PostgreSQL Connection
# Default: postgres user, password "password", local database "flight_club"
# Change credentials as needed for your local setup
DATABASE_URL="postgresql://postgres:password@localhost:5432/flight_club"

# Dev Mode Authentication
# When NODE_ENV=development, the auth middleware accepts this token for testing
# Authorization: Bearer dev-mode-local-testing-token
DEV_AUTH_TOKEN=dev-mode-local-testing-token

